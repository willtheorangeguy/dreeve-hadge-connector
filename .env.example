CONNECTOR_VERSION=0.1.0
GITHUB_REPOSITORY=your-github-name/health
# Fine-grained token restricted to that repository, with Contents: Read-only.
GITHUB_TOKEN=replace-with-your-read-only-token
# Leave blank to follow the repository's default branch.
GITHUB_BRANCH=
# Existing host directory mounted as /var/www/watch by Dreeve.
# Windows Docker Desktop example: C:/Users/you/dreeve/watch
DREEVE_WATCH_PATH=/absolute/path/to/dreeve/watch
SYNC_INTERVAL_SECONDS=300
# Optional inclusive date at midnight UTC; blank imports all available history.
EXPORT_SINCE=
